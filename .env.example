# ── Scriptura Web · variables de entorno ─────────────────────────────────────
# Copia este archivo a .env.local (desarrollo) y configura los valores.
# Los secretos NUNCA se versionan en el repositorio (directriz del proyecto).

# Conexión directa a PostgreSQL (servidor únicamente).
# Desarrollo local (docker compose up -d):
#   postgres://scriptura:scriptura@localhost:5433/scriptura
# Supabase: cadena "Connection string" del proyecto (sección Database).
DATABASE_URL=

# Proyecto Supabase (autenticación): Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio de Supabase. Opcional para desarrollo ordinario;
# necesaria para tareas administrativas del servidor. Extremadamente sensible.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (usada en redirecciones y, en el futuro, correos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Fases posteriores (reservadas; dejar vacías hasta su integración) ────────
# Fase 5 — proveedor de IA sustituible (clave solo en servidor):
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_BASE_URL=
# AI_PROVIDER_MODEL=
# Fase 6 — correo transaccional:
# RESEND_API_KEY=
# EMAIL_FROM=
